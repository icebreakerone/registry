{
    "openapi": "3.1.0",
    "info":
    {
        "title": "Emissions data",
        "version": "2026-03-12",
        "x-ib1-registry-label": "emissions-data",
        "description": "API for retrieving greenhouse gas emission data and metadata derived from energy consumption."
    },
    "servers":
    [
        {
            "url": "{endpointURL}",
            "variables":
            {
                "endpointURL":
                {
                    "default": "https://endpointurl-not-specified.ib1.org"
                }
            }
        }
    ],
    "security":
    [
        {
            "mTLS":
            []
        }
    ],
    "tags":
    [
        {
            "name": "Emissions",
            "description": "Operations for retrieving greenhouse gas emission data and metadata derived from energy consumption."
        }
    ],
    "paths":
    {
        "/emissions":
        {
            "get":
            {
                "summary": "EmissionsReport",
                "operationId": "getEmissions",
                "tags":
                [
                    "Emissions"
                ],
                "parameters":
                [
                    {
                        "name": "from",
                        "in": "query",
                        "required": true,
                        "schema":
                        {
                            "type": "string",
                            "format": "date-time",
                            "title": "From",
                            "description": "ISO8601 timestamp with 'Z' (UTC); inclusive"
                        }
                    },
                    {
                        "name": "to",
                        "in": "query",
                        "required": false,
                        "schema":
                        {
                            "type": "string",
                            "format": "date-time",
                            "title": "To",
                            "description": "ISO8601 timestamp with 'Z' (UTC); exclusive (defaults to 'now' if omitted)"
                        }
                    }
                ],
                "responses":
                {
                    "200":
                    {
                        "description": "Successful Response",
                        "content":
                        {
                            "application/json":
                            {
                                "schema":
                                {
                                    "$ref": "#/components/schemas/EmissionsReport"
                                },
                                "examples":
                                {
                                    "emissions":
                                    {
                                        "summary": "Example emissions",
                                        "value":
                                        {
                                            "data":
                                            [
                                                {
                                                    "type": "electricity",
                                                    "from": "2023-06-01T00:00:00Z",
                                                    "to": "2023-10-18T00:30:00Z",
                                                    "takenAt": "2024-07-01T00:00:00Z",
                                                    "emissions":
                                                    {
                                                        "value": 123.45,
                                                        "unitCode": "KGM"
                                                    }
                                                }
                                            ],
                                            "provenance":
                                            {
                                                "ib1:provenance": "https://registry.example.trust.ib1.org/trust-framework",
                                                "origins":
                                                [
                                                    "Esfjwwyjh2iMa-LEHO1N"
                                                ],
                                                "steps":
                                                [
                                                    "eyJpZCI6IlVSZDB3Z3MiLCJ0eXBlIjoidHJhbnNmZXIiLCJmcm9tIjoiaHR0cHM6...MyOjU2WiJ9",
                                                    "eyJpZCI6Iml0SU5zR3RVIiwidHlwZSI6InJlY2VpcHQiLCJmcm9tIjoiaHR0cH...jE2OjMxWiJ9",
                                                    [
                                                        0,
                                                        "123456",
                                                        "2024-10-17T12:16:31Z",
                                                        "MEUCIQDNk3nS64bmGvMJwfdVWfyGuheGDEbB8-b5Ur2H9Iat9gIgc...eGO3GvzH2EJut707lA="
                                                    ]
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "202":
                    {
                        "description": "The data source is valid but emissions data is not yet available.",
                        "headers":
                        {
                            "Retry-After":
                            {
                                "description": "Time after which the client should retry the request. Can be seconds or an HTTP-date.",
                                "schema":
                                {
                                    "type": "string",
                                    "description": "Seconds as integer or RFC 7231 date-time format."
                                }
                            }
                        },
                        "content":
                        {
                            "application/json":
                            {
                                "schema":
                                {
                                    "$ref": "#/components/schemas/DataNotReady"
                                },
                                "examples":
                                {
                                    "notReady":
                                    {
                                        "summary": "Example data not ready response",
                                        "value":
                                        {
                                            "message": "Emissions data is not yet available."
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401":
                    {
                        "description": "Unauthorized"
                    },
                    "403":
                    {
                        "description": "Forbidden - insufficient permissions"
                    },
                    "404":
                    {
                        "description": "Not Found - source or measure not found"
                    },
                    "422":
                    {
                        "description": "Validation Error",
                        "content":
                        {
                            "application/json":
                            {
                                "schema":
                                {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    },
                    "500":
                    {
                        "description": "Internal Server Error"
                    }
                }
            }
        }
    },
    "components":
    {
        "schemas":
        {
            "HTTPValidationError":
            {
                "properties":
                {
                    "detail":
                    {
                        "items":
                        {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "ValidationError":
            {
                "properties":
                {
                    "loc":
                    {
                        "items":
                        {
                            "anyOf":
                            [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg":
                    {
                        "type": "string",
                        "title": "Message"
                    },
                    "type":
                    {
                        "type": "string",
                        "title": "Error Type"
                    }
                },
                "type": "object",
                "required":
                [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            },
            "DataNotReady":
            {
                "type": "object",
                "title": "Data Not Ready",
                "description": "Response indicating that consumption data is not yet available.",
                "properties":
                {
                    "message":
                    {
                        "type": "string",
                        "description": "Human readable explanation."
                    }
                },
                "required":
                [
                    "message"
                ]
            },
            "EmissionsReport":
            {
                "properties":
                {
                    "data":
                    {
                        "items":
                        {
                            "$ref": "#/components/schemas/EmissionsEntry"
                        },
                        "type": "array",
                        "title": "Data"
                    },
                    "provenance":
                    {
                        "$ref": "#/components/schemas/Provenance"
                    }
                },
                "type": "object",
                "required":
                [
                    "data",
                    "provenance"
                ],
                "title": "EmissionsReport"
            },
            "EmissionsEntry":
            {
                "properties":
                {
                    "type":
                    {
                        "type": "string",
                        "title": "Type",
                        "enum":
                        [
                            "electricity",
                            "gas"
                        ],
                        "default": "electricity",
                        "description": "Must be 'electricity' or 'gas'."
                    },
                    "from":
                    {
                        "type": "string",
                        "format": "date-time",
                        "title": "From",
                        "description": "ISO8601 timestamp with 'Z' (UTC); inclusive. Must specify the first day of a calendar month"
                    },
                    "to":
                    {
                        "type": "string",
                        "format": "date-time",
                        "title": "To",
                        "description": "ISO8601 timestamp with 'Z' (UTC); exclusive. Must specify the first day of a calendar month"
                    },
                    "takenAt":
                    {
                        "type": "string",
                        "format": "date-time",
                        "title": "Taken At",
                        "description": "Timestamp when emissions were calculated. Must be after 'to'."
                    },
                    "emissions":
                    {
                        "$ref": "#/components/schemas/Emissions"
                    }
                },
                "type": "object",
                "required":
                [
                    "type",
                    "from",
                    "to",
                    "takenAt",
                    "emissions"
                ],
                "title": "EmissionsEntry"
            },
            "Emissions":
            {
                "properties":
                {
                    "value":
                    {
                        "type": "number",
                        "title": "Value",
                        "minimum": 0,
                        "description": "Positive number representing CO2e emissions."
                    },
                    "unitCode":
                    {
                        "type": "string",
                        "title": "Unit Code",
                        "enum":
                        [
                            "KGM"
                        ],
                        "description": "Unit code (CEFACT): Must be KGM (kilograms of CO2 equivalent)."
                    }
                },
                "type": "object",
                "required":
                [
                    "value",
                    "unitCode"
                ],
                "title": "Emissions"
            },
            "ProvenanceStep":
            {
                "type": "array",
                "items":
                {
                    "anyOf":
                    [
                        {
                            "type": "string"
                        },
                        {
                            "$ref": "#/components/schemas/ProvenanceStep"
                        }
                    ]
                },
                "description": "Recursive structure representing a series of audit steps for data provenance."
            },
            "Provenance":
            {
                "type": "object",
                "properties":
                {
                    "ib1:provenance":
                    {
                        "type": "string",
                        "format": "uri",
                        "description": "URI identifying the Trust Framework."
                    },
                    "origins":
                    {
                        "type": "array",
                        "items":
                        {
                            "type": "string"
                        },
                        "description": "Array of identifiers indicating data origin."
                    },
                    "steps":
                    {
                        "type": "array",
                        "items":
                        {
                            "$ref": "#/components/schemas/ProvenanceStep"
                        },
                        "description": "Provenance steps; each item may be a step or a nested array of steps."
                    }
                },
                "required":
                [
                    "ib1:provenance",
                    "origins",
                    "steps"
                ]
            }
        },
        "securitySchemes":
        {
            "mTLS":
            {
                "type": "mutualTLS"
            }
        }
    }
}