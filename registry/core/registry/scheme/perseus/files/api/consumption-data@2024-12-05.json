{
  "openapi": "3.1.0",
  "info": {
    "title": "Consumption data",
    "version": "2024-12-05",
    "x-ib1-registry-label": "consumption-data",
    "description": "API for retrieving energy consumption data and metadata from energy meters or virtual sources."
  },
  "servers": [
    {
      "url": "{endpointURL}",
      "variables": {
        "endpointURL": {
          "default": "https://endpointurl-not-specified.ib1.org"
        }
      }
    }
  ],
  "security": [
    {
      "mTLS": []
    }
  ],
  "tags": [
    {
      "name": "Consumption",
      "description": "Operations for retrieving energy consumption data and metadata."
    }
  ],
  "paths": {
    "/datasources": {
      "get": {
        "summary": "Datasources",
        "operationId": "getConsumptionSources",
        "tags": ["Consumption"],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataSources"
                },
                "examples": {
                  "datasources": {
                    "summary": "Example data sources",
                    "value": {
                      "data": [
                        {
                          "id": "S90/r2+mSV2",
                          "type": "electricity",
                          "location": {
                            "ukPostcodeOutcode": "CF99"
                          },
                          "availableMeasures": ["import", "export"]
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden - insufficient permissions" },
          "404": { "description": "Not Found - source or measure not found" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },
    "/datasources/{id}/{measure}": {
      "get": {
        "summary": "Consumption",
        "operationId": "getConsumptionData",
        "tags": ["Consumption"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id"
            }
          },
          {
            "name": "measure",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Measure",
              "enum": ["import", "export"],
              "default": "import",
              "description": "import for energy consumed from the grid, export for energy exported to the grid"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "title": "From",
              "description": "ISO8601 timestamp with 'Z' (UTC); inclusive"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time",
              "title": "To",
              "description": "ISO8601 timestamp with 'Z' (UTC); exclusive (defaults to 'now' if omitted)"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterData"
                },
                "examples": {
                  "meters": {
                    "summary": "Example meter data",
                    "value": {
                      "data": [
                        {
                          "cumulative": {
                            "unitCode": "WHR",
                            "value": 1234.5
                          },
                          "energy": {
                            "unitCode": "WHR",
                            "value": 123.45
                          },
                          "from": "2023-10-18T00:00:00Z",
                          "takenAt": "2023-10-19T00:00:00Z",
                          "to": "2023-10-18T00:30:00Z",
                          "type": "electricity"
                        }
                      ],
                      "location": {
                        "ukPostcodeOutcode": "CF99"
                      },
                      "provenance": {
                        "ib1:provenance": "https://registry.example.trust.ib1.org/trust-framework",
                        "origins": ["Esfjwwyjh2iMa-LEHO1N"],
                        "steps": [
                          "eyJpZCI6IlVSZDB3Z3MiLCJ0eXBlIjoidHJhbnNmZXIiLCJmcm9tIjoiaHR0cHM6...MyOjU2WiJ9",
                          "eyJpZCI6Iml0SU5zR3RVIiwidHlwZSI6InJlY2VpcHQiLCJmcm9tIjoiaHR0cH...jE2OjMxWiJ9",
                          [
                            0,
                            "123456",
                            "2024-10-17T12:16:31Z",
                            "MEUCIQDNk3nS64bmGvMJwfdVWfyGuheGDEbB8-b5Ur2H9Iat9gIgc...eGO3GvzH2EJut707lA="
                          ]
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden - insufficient permissions" },
          "404": { "description": "Not Found - source or measure not found" },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "500": { "description": "Internal Server Error" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LowResolutionLocation": {
        "type": "object",
        "title": "Low Resolution Location",
        "description": "Low-resolution, privacy-preserving location information.",
        "properties": {
          "ukPostcodeOutcode": {
            "type": "string",
            "description": "UK postcode outcode (e.g., 'CF99', 'SW1A', 'B1', 'EH99').",
            "pattern": "^[A-Z]{1,2}[0-9][0-9A-Z]?$"
          }
        },
        "additionalProperties": false,
        "anyOf": [
          { "required": ["ukPostcodeOutcode"] }
        ],
        "example": {
          "ukPostcodeOutcode": "CF99"
        }
      },
      "Consumption": {
        "properties": {
          "value": {
            "type": "number",
            "title": "Value",
            "minimum": 0,
            "description": "Positive number representing energy amount transferred."
          },
          "unitCode": {
            "type": "string",
            "title": "Unit Code",
            "enum": ["KWH", "WHR"],
            "description": "Unit code (CEFACT): KWH, WHR. (MTQ may be added for gas later)."
          }
        },
        "type": "object",
        "required": [
          "value",
          "unitCode"
        ],
        "title": "Consumption"
      },
      "DataSource": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Opaque identifier for the data source (e.g., meter or virtual meter ID)."
          },
          "type": {
            "type": "string",
            "title": "Type",
            "enum": ["electricity"],
            "default": "electricity",
            "description": "Must be 'electricity' (reserved for future types like Gas, Coal, etc.)."
          },
          "location": {
            "$ref": "#/components/schemas/LowResolutionLocation"
          },
          "availableMeasures": {
            "items": {
              "type": "string",
              "enum": ["import", "export"]
            },
            "type": "array",
            "title": "Available Measures",
            "description": "Permitted values: 'import', 'export'."
          }
        },
        "type": "object",
        "required": [
          "id",
          "type",
          "location",
          "availableMeasures"
        ],
        "title": "DataSource"
      },
      "DataSources": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/DataSource"
            },
            "type": "array",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "DataSources"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MeterData": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/Reading"
            },
            "type": "array",
            "title": "Data"
          },
          "location": {
            "$ref": "#/components/schemas/LowResolutionLocation"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          }
        },
        "type": "object",
        "required": [
          "data",
          "location",
          "provenance"
        ],
        "title": "MeterData"
      },
      "Reading": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "enum": ["electricity"],
            "default": "electricity",
            "description": "Must be 'electricity'. Reserved for other types like gas, coal in future."
          },
          "from": {
            "type": "string",
            "format": "date-time",
            "title": "From",
            "description": "ISO8601 timestamp with 'Z' (UTC); inclusive."
          },
          "to": {
            "type": "string",
            "format": "date-time",
            "title": "To",
            "description": "ISO8601 timestamp with 'Z' (UTC); exclusive."
          },
          "takenAt": {
            "type": "string",
            "format": "date-time",
            "title": "Taken At",
            "description": "Timestamp when reading was retrieved. Must be after 'to'."
          },
          "energy": {
            "$ref": "#/components/schemas/Consumption"
          },
          "cumulative": {
            "$ref": "#/components/schemas/Consumption"
          }
        },
        "type": "object",
        "required": [
          "type",
          "from",
          "to",
          "takenAt",
          "energy",
          "cumulative"
        ],
        "title": "Reading"
      },
      "ProvenanceStep": {
        "type": "array",
        "items": {
          "anyOf": [
            { "type": "string" },
            { "$ref": "#/components/schemas/ProvenanceStep" }
          ]
        },
        "description": "Recursive structure representing a series of audit steps for data provenance."
      },
      "Provenance": {
        "type": "object",
        "properties": {
          "ib1:provenance": {
            "type": "string",
            "format": "uri",
            "description": "URI identifying the Trust Framework."
          },
          "origins": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Array of identifiers indicating data origin."
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProvenanceStep"
            },
            "description": "Provenance steps; each item may be a step or a nested array of steps."
          }
        },
        "required": ["ib1:provenance", "origins", "steps"]
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "mTLS": {
        "type": "mutualTLS"
      }
    }
  }
}