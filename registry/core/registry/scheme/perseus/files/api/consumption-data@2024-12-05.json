{
  "openapi": "3.0.0",
  "info": {
    "title": "Consumption data",
    "version": "2024-12-05",
    "x-ib1-registry-label": "consumption-data"
  },
  "servers": [
    {
      "url": "{endpointURL}",
      "variables": {
        "endpointURL": {
          "default": "https://endpointurl-not-specified.ib1.org"
        }
      }
    }
  ],
  "paths": {
    "/datasources": {
      "get": {
        "summary": "Datasources",
        "operationId": "datasources_datasources_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataSources"
                }
              }
            }
          }
        }
      }
    },
    "/datasources/{id}/{measure}": {
      "get": {
        "summary": "Consumption",
        "operationId": "consumption_datasources__id___measure__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id"
            }
          },
          {
            "name": "measure",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Measure",
              "description": "import for energy consumed from the grid, export for energy exported to the grid"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "From",
              "description": "ISO8601 timestamp with 'Z' (UTC); inclusive"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "To",
              "description": "ISO8601 timestamp with 'Z' (UTC); exclusive (defaults to 'now' if omitted)"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterData"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Consumption": {
        "properties": {
          "value": {
            "type": "number",
            "title": "Value",
            "minimum": 0,
            "description": "Positive number representing energy amount transferred."
          },
          "unitCode": {
            "type": "string",
            "title": "Unitcode",
            "description": "Unit code (CEFACT): KWH, WHR, JOU. (MTQ may be added for gas later)."
          }
        },
        "type": "object",
        "required": [
          "value",
          "unitCode"
        ],
        "title": "Consumption"
      },
      "DataSource": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Opaque identifier for the data source (e.g., meter or virtual meter ID)."
          },
          "type": {
            "type": "string",
            "title": "Type",
            "description": "Must be 'Electricity' (reserved for future types like Gas, Coal, etc.)."
          },
          "availableMeasures": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Availablemeasures",
            "description": "Permitted values: 'Import', 'Export'."
          }
        },
        "type": "object",
        "required": [
          "id",
          "type",
          "availableMeasures"
        ],
        "title": "DataSource"
      },
      "DataSources": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/DataSource"
            },
            "type": "array",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "DataSources"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MeterData": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/Reading"
            },
            "type": "array",
            "title": "Data"
          },
          "provenance": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "items": {},
                  "type": "array"
                }
              ]
            },
            "type": "array",
            "title": "Provenance",
            "description": "Audit trail for source of data (e.g., transfer, receipt, user input)."
          }
        },
        "type": "object",
        "required": [
          "data",
          "provenance"
        ],
        "title": "MeterData",
        "examples": [
          {
            "data": [
              {
                "cumulative": {
                  "unitCode": "WHR",
                  "value": 1234.5
                },
                "energy": {
                  "unitCode": "WHR",
                  "value": 123.45
                },
                "from": "2023-10-18T00:00:00Z",
                "takenAt": "2023-10-19T00:00:00Z",
                "to": "2023-10-18T00:30:00Z",
                "type": "Electricity"
              }
            ],
            "provenance": [
              [
                "eyJpZCI6IlVSZDB3Z3MiLCJ0eXBlIjoidHJhbnNmZXIiLCJmcm9tIjoiaHR0cHM6...MyOjU2WiJ9",
                "eyJpZCI6Iml0SU5zR3RVIiwidHlwZSI6InJlY2VpcHQiLCJmcm9tIjoiaHR0cH...jE2OjMxWiJ9",
                [
                  0,
                  "123456",
                  "2024-10-17T12:16:31Z",
                  "MEUCIQDNk3nS64bmGvMJwfdVWfyGuheGDEbB8-b5Ur2H9Iat9gIgc...eGO3GvzH2EJut707lA="
                ]
              ]
            ]
          }
        ]
      },
      "Reading": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "description": "Must be 'Electricity'. Reserved for other types like gas, coal in future."
          },
          "from": {
            "type": "string",
            "format": "date-time",
            "title": "From",
            "description": "ISO8601 timestamp with 'Z' (UTC); inclusive."
          },
          "to": {
            "type": "string",
            "format": "date-time",
            "title": "To",
            "description": "ISO8601 timestamp with 'Z' (UTC); exclusive."
          },
          "takenAt": {
            "type": "string",
            "format": "date-time",
            "title": "Takenat",
            "description": "Timestamp when reading was retrieved. Must be after 'to'."
          },
          "energy": {
            "$ref": "#/components/schemas/Consumption"
          },
          "cumulative": {
            "$ref": "#/components/schemas/Consumption"
          }
        },
        "type": "object",
        "required": [
          "type",
          "to",
          "takenAt",
          "energy",
          "cumulative"
        ],
        "title": "Reading"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}