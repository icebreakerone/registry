<%
  if (resources.length == 1) && (basename != "#{OUTPUT_DIR}/registry")
#    write_rdf_as_html = []
    write_rdf_as_html = Proc.new do |resource, with_uri|
      %><table class="rdf-resource"><%
      if with_uri
        %><tr><th>URI</th><td><div><%= ERB::Util.h(resource.uri.to_uri_s) %></div></td></tr><%
      end
      props = resource._properties_for_template.group_by { |_,_,symbol| symbol }
      props.each do |symbol, values|
        %><tr><th><%= values.first.first.suffix %></th><td><%
        values.each do |uri, value, symbol|
          %><div><%
          value = value.uri if value.kind_of? RdfClass
          if value.kind_of? RdfUri
            display = value.to_uri_s
            if value.prefix == Ns.ib1_prefix
              %>ib1:<%= ERB::Util.h(value.suffix.to_s) %><%
            elsif value.prefix == Ns.dcat_prefix
              %>dcat:<%= ERB::Util.h(value.suffix.to_s) %><%
            else
              if value.prefix == Ns.registry_prefix
                href = "/"+value.suffix
              else
                href = display
              end
              %><a href="<%= ERB::Util.h(href) %>"><%= ERB::Util.h(display) %></a><%
            end
          elsif value.kind_of? Resource
            %><a href="/<%= ERB::Util.h(value.uri.suffix) %>"><%= ERB::Util.h(value.uri.to_uri_s) %></a><%          
          else
            %><%= ERB::Util.h(value.to_s).gsub(/\n+/,"<br/>") %><%
          end
          %></div><%
        end
        %></td></tr><%
      end
      resource._bnodes_for_template.each do |url, bnode, symbol|
        %><tr><th><%= url.suffix %></th><td><%
        write_rdf_as_html.call(bnode, false)
        %></td></tr><%
      end
      %></table><%
    end
    write_rdf_as_html.call(resources.first, true)
  end
%>

<p>A GET request made to this URI uses HTTP Content Negotiation. However, if you explicitly wish to retrieve a particular serialisation, you can also do so using the following URLs:</p>

<dl><%
  OUTPUT_FORMATS.each do |_, extension, name|
    filename = ERB::Util.h(File.basename(basename)) + extension
    %><dt><a href="<%= filename %>"><%= filename %></a></dt><%=
    %><dd><%= name %><%
  end
%></dl>
