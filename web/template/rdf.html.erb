<%
  if (resources.length == 1) && (basename != "#{OUTPUT_DIR}/registry")

    relevant_resources = [resources.first] + resources.first._bnodes_for_template.map {|b| b[1]}

    # Buttons to OpenAPI viewer
    relevant_resources.each do |r|
      r.each_value_of_class(OpenAPIFile) do |openapi, symbol, uri|
        %><div class="openapi-button">
          <a class="btn" href="/openapi-viewer/?a=/<%= ERB::Util.h(openapi.suffix.sub(/\#.+?\z/,'')) %>">
            <%= ERB::Util.h(symbol.to_s.gsub('_',' ').gsub('description',' ').strip.capitalize) %> API documentation
          </a>
        </div><%
      end
    end

    # Links to PDF files with thumbnails
    resources.first.each_value_of_class(PdfFile) do |pdf, symbol, uri|
      %><div class="pdf-thumbnail">
        <a href="/<%= ERB::Util.h(pdf.suffix) %>">
          <img src="<%= PdfRenderer.first_page_data_url(pdf.pathname, 196) %>">
        </a>
      </div><%
    end

    # Render in linked Markdown files
    resources.first.each_value_of_class(MarkdownFile) do |markdown, symbol, uri|
      %><div class="text-of-resource"><%=
        markdown.render().
          # Remove title from document if it matches exactly, to avoid repeating the title of the page.
          # This won't necessarily get everything, but is good enough to tidy.
          sub(/\s*<h1[^>]*>\s*#{Regexp.escape(title)}\s*<\/h1>\s*/i, '')
      %></div><%
    end

    write_rdf_as_html = Proc.new do |resource, with_uri|
      %><table class="rdf-resource"><%
      if with_uri
        %><tr><th>URI</th><td><div><%= ERB::Util.h(resource.uri.to_uri_s) %></div></td></tr><%
      end
      props = resource._properties_for_template.group_by { |_,_,symbol| symbol }
      props.each do |symbol, values|
        %><tr><th><%= values.first.first.suffix %></th><td><%
        values.each do |uri, value, symbol|
          %><div><%
          value = value.uri if value.kind_of? RdfClass
          if value.kind_of? RdfUri
            display = value.to_uri_s
            if value.prefix == Ns.ib1_prefix
              %>ib1:<%= ERB::Util.h(value.suffix.to_s) %><%
            elsif value.prefix == Ns.dcat_prefix
              %>dcat:<%= ERB::Util.h(value.suffix.to_s) %><%
            else
              if value.prefix == Ns.registry_prefix
                href = "/"+value.suffix
              else
                href = display
              end
              %><a href="<%= ERB::Util.h(href) %>"><%= ERB::Util.h(display) %></a><%
            end
          elsif value.kind_of? Resource
            %><a href="/<%= ERB::Util.h(value.uri.suffix) %>"><%= ERB::Util.h(value.uri.to_uri_s) %></a><%          
          else
            %><%= ERB::Util.h(value.to_s).gsub(/\n+/,"<br/>") %><%
          end
          %></div><%
        end
        %></td></tr><%
      end
      resource._bnodes_for_template.each do |url, bnode, symbol|
        %><tr><th><%= url.suffix %></th><td><%
        write_rdf_as_html.call(bnode, false)
        %></td></tr><%
      end
      %></table><%
    end
    write_rdf_as_html.call(resources.first, true)

    linked = resources.first.find_all_linked_resources
    unless linked.empty?
      %><h2>Related resources</h2><%
      by_classname = Hash.new {|h,k| h[k] = [] }
      linked.each do |lr|
        if lr.respond_to?(:human_readable_name) && !lr.is_bnode?
          klass = lr.class
          by_classname[(klass.respond_to?(:class_human_readable_name) ? klass.class_human_readable_name : klass.name) || '_Anon'] << lr
        end
      end
      by_classname.keys.sort.each do |classname|
        res = by_classname[classname]
        %>
          <h3 id="<%= ERB::Util.h(classname) %>"><%= ERB::Util.h(classname) %></h3>
          <ul>
        <%
        res.sort! { |a,b| a.human_readable_name <=> b.human_readable_name }
        res.each do |r|
          %><li><a href="/<%= ERB::Util.h(r.uri.suffix) %>"><%= ERB::Util.h(r.human_readable_name) %></a></li><%
        end
        %></ul><%
      end
    end
  end
%>

<h2>Definitive version (machine readable)</h2>
<p>A GET request made to this URI uses HTTP Content Negotiation. However, if you explicitly wish to retrieve a particular serialisation, you can also do so using the following URLs:</p>

<dl><%
  OUTPUT_FORMATS.each do |_, extension, name|
    filename = ERB::Util.h(File.basename(basename)) + extension
    %><dt><a href="<%= filename %>"><%= filename %></a></dt><%=
    %><dd><%= name %><%
  end
%></dl>
